# Meeting Translator — copy to %APPDATA%\meeting-translator-desktop\.env
TRANSLATOR_PROVIDER=grok

# Grok (xAI) — ưu tiên dịch live meeting / live caption segment
# https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-2-latest

# OpenAI — Whisper STT (Live Caption) + fallback dịch khi Grok hết quota
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
