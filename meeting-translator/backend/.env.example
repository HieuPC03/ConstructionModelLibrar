# Chi dung ChatGPT (OpenAI API)
TRANSLATOR_PROVIDER=openai

# Mot dong, khong khoang trang thua, khong ngoac kep
OPENAI_API_KEY=

# Nhan dang giong (ChatGPT API) — tu dong fallback whisper-1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Dich van ban (ChatGPT)
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# Thư mục lưu bản ghi hội thoại
RECORDINGS_DIR=./recordings
