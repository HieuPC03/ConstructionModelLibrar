# Nha cung cap: openai | gemini | google
# google = Google Translate (dich chu mien phi, khong can key)
# gemini = can GEMINI_API_KEY (dich + nhan dang giong hoc)
# openai = can OPENAI_API_KEY + billing
TRANSLATOR_PROVIDER=google

OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Gemini (mien phi tai https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
